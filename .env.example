# Copy to .env and fill in. .env is gitignored.

# Required ONLY for `cua discover` (the LLM-driven discovery run).
# Replay, the operator console, and the whole test suite run without it.
ANTHROPIC_API_KEY=

# Model for the discovery loop. Opus for the graded run; point it at a cheaper
# model while iterating on the loop itself -- an iteration run costs a few cents
# against roughly $1.70 for an Opus run, and `cua dry-run` costs nothing at all.
CUA_MODEL=claude-opus-5
CUA_EFFORT=high

# Model for the authoring review pass. Deliberately smaller: it fills a fixed
# schema from an already-successful transcript, and its proposals are validated
# against observed screens in code afterwards regardless.
CUA_REVIEWER_MODEL=claude-haiku-4-5-20251001

# mockbank fixture credentials. These are FAKE — mockbank accepts them and
# nothing else. Referenced by profiles as env:MOCKBANK_USER / env:MOCKBANK_PASS
# so that credentials are never written into a profile, artifact, or log.
MOCKBANK_USER=operator
MOCKBANK_PASS=demo-pass-not-real
