# Copy to .env and fill in. .env is gitignored.

# Required ONLY for `cua discover` (the LLM-driven discovery run).
# Replay, the operator console, and the whole test suite run without it.
ANTHROPIC_API_KEY=

# Model used for discovery. Override to trade cost for capability.
CUA_MODEL=claude-opus-5
CUA_EFFORT=high

# mockbank fixture credentials. These are FAKE — mockbank accepts them and
# nothing else. Referenced by profiles as env:MOCKBANK_USER / env:MOCKBANK_PASS
# so that credentials are never written into a profile, artifact, or log.
MOCKBANK_USER=operator
MOCKBANK_PASS=demo-pass-not-real
